# TossPayments 클라이언트 키
VITE_TOSS_CLIENT_KEY=실제 키

#공공데이터 포털 인증키
DATA_GO_KR_SERVICE_KEY=실제 키

# OpenClaw Gateway (로컬). 토큰은 ~/.openclaw/openclaw.json 의 gateway.auth.token
