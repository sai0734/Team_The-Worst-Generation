# JWT 로그인 토큰 서명용 비밀값 - 외부 API 아님
JWT_SECRET=실제 값

# 구글 비전 API - 알러지 성분표 OCR
GOOGLE_VISION_API_KEY=실제 키

# SafetyKorea 리콜/인증정보 공공 API
SAFETYKOREA_API_KEY=실제 키

# 카카오 소셜 로그인용 REST API 키 - 카카오맵 키와는 별개
VITE_KAKAO_REST_API_KEY=실제 키

# 카카오맵 JavaScript 키 (REST API 키 아님)
VITE_KAKAO_MAP_API_KEY=실제 키

# 응급실 조회 공공 API
HOSPITAL_ER_API_KEY=실제 키

# 국립중앙의료원 응급의료기관정보 서비스
HOSPITAL_ER_BASE_URL=실제 키

# 공공데이터 포털 인증키
DATA_GO_KR_SERVICE_KEY=실제 키

# TossPayments 인화주문 결제
TOSS_SECRET_KEY=실제 키

# TossPayments 클라이언트 키
VITE_TOSS_CLIENT_KEY=실제 키

# AI행동교정 - 네이버 뉴스검색 API
NAVER_CLIENT_ID=실제 키
NAVER_CLIENT_SECRET=실제 키

# AI행동교정 - 유튜브 Data API
YOUTUBE_API_KEY=실제 키

# OpenClaw Gateway (로컬). 토큰은 ~/.openclaw/openclaw.json 의 gateway.auth.token
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=실제 키

# 기상청 단기예보 조회서비스 (공공데이터포털)
WEATHER_API_SERVICE_KEY=실제 키
OPENCLAW_INTERNAL_KEY=실제 키

# Android Termux SMS 브리지. 문자 요청은 항상 실제 발송 경로를 사용합니다.
ANDROID_SMS_BRIDGE_URL=http://폰IP:8787
ANDROID_SMS_BRIDGE_KEY=실제 키

# 맞춤 동화 AI 서버
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=parenting-qwen:8b
STORY_LLM_ENABLED=true
STORY_TTS_PROVIDER=SUPERTONIC
STORY_TTS_FALLBACK_PROVIDER=PIPER
STORY_TTS_MODEL_DIR=models/tts
STORY_TTS_SUPERTONIC_MODEL_DIR=models/tts/sherpa-onnx-supertonic-3-tts-int8-2026-05-11
STORY_TTS_SPEAKER_ID=0
STORY_TTS_SPEED=0.95
STORY_TTS_NUM_STEPS=8
STORY_TTS_PIPER_VOICE=ko_KR-kss-medium
STORY_TTS_PIPER_MODEL_DIR=models/tts
AI_LOG_LEVEL=INFO
AI_SERVER_BASE_URL=http://127.0.0.1:5000
