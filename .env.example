# JWT 로그인 토큰 서명용 비밀값 - 외부 API 아님
JWT_SECRET=실제 값

# 구글 비전 API - 알러지 성분표 OCR
GOOGLE_VISION_API_KEY=실제 키

# SafetyKorea 리콜/인증정보 공공 API
SAFETYKOREA_API_KEY=실제 키

# 카카오 소셜 로그인용 REST API 키 - 카카오맵 키와는 별개
VITE_KAKAO_REST_API_KEY=실제 키

# 카카오맵 JavaScript 키 (REST API 키 아님)
VITE_KAKAO_MAP_API_KEY=실제 키

# 응급실 조회 공공 API
HOSPITAL_ER_API_KEY=실제 키

# 국립중앙의료원 응급의료기관정보 서비스
