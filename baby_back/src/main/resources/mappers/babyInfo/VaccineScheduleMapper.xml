<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backend.vaccination.mapper.VaccineScheduleMapper">

    <select id="selectList" resultType="com.backend.vaccination.domain.VaccineSchedule">
        SELECT schedule_no, vaccine_name, dose_label, recommended_month, display_order
        FROM tbl_vaccine_schedule
        ORDER BY display_order
    </select>

</mapper>