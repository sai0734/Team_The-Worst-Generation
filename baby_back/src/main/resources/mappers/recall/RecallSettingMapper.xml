<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backend.recall.mapper.RecallSettingMapper">

    <select id="selectByEmail" resultType="com.backend.recall.domain.RecallSetting">
        SELECT email, notification_phone
        FROM tbl_recall_setting
        WHERE email = #{email}
    </select>

    <insert id="insert">
        INSERT INTO tbl_recall_setting (email, notification_phone)
        VALUES (#{email}, #{notificationPhone})
    </insert>

    <update id="updatePhone">
        UPDATE tbl_recall_setting
        SET notification_phone = #{notificationPhone}
        WHERE email = #{email}
    </update>

</mapper>
